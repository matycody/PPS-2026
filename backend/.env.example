# Puerto del servidor (por defecto 3001)
PORT=3001

# Base de datos Neon (connection string directa en local; con -pooler en Render)
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require

# Supabase (pedir los valores al equipo)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Mails de los admins iniciales, separados por coma
ADMIN_EMAILS=tu-mail@ejemplo.com