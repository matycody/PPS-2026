# Puerto del servidor (por defecto 3001)
PORT=3001

# Base de datos Neon (connection string directa en local; con -pooler en Render)
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require

# Supabase (pedir los valores al equipo)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Mails de los admins iniciales, separados por coma
ADMIN_EMAILS=tu-mail@ejemplo.com

# IA para leer planillas (Gemini). Modelo y respaldos son opcionales
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Monitoreo de errores (Sentry). Vacío = desactivado
SENTRY_DSN=
SENTRY_TEST_KEY=

# Opcionales (ajuste fino)
# BASE_URL=http://localhost:3001
# MAX_CONN_PER_IP=
# MEMO_TTL_MS=
# MICROCACHE_TTL_MS=
# TABLE_LOCK_GRACE_MS=
