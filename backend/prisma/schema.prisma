generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum Role {
  ADMIN
  REFEREE
  PLAYER
}

enum Sex {
  M
  F
}

// Rama: mixto, masculino, femenino
enum Branch {
  MIXED
  MALE
  FEMALE
}

enum Modality {
  FOAM
  CLOTH
}

enum MatchFunction {
  REFEREE
  TABLE
}

enum MatchStatus {
  SCHEDULED
  READY
  LIVE
  FINISHED
  CANCELLED
  SUSPENDED
}

enum ProfileStatus {
  PENDIENTE_VINCULACION
  VINCULADO
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Usuarios y perfiles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id         String   @id @default(uuid())
  supabaseId String?  @unique // null solo para admins del seed hasta su primer login
  email      String   @unique // fuente de verdad del mail
  username   String?  @unique @db.VarChar(20) // para iniciar sesión; solo lo ve la organización (en minúsculas)
  roles      Role[] // vacÃ­o = usuario registrado
  profileId  String?  @unique
  photo      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  profile        Profile?          @relation(fields: [profileId], references: [id])
  favorites      Favorite[]
  assignments    MatchAssignment[]
  clockActions   ClockAction[]
  playerRequests PlayerRequest[]
}

// Perfil inscripto por la organizaciÃ³n (jugador y/o Ã¡rbitro)
model Profile {
  id        String        @id @default(uuid())
  dni       String        @unique
  name      String
  email     String        @unique // solo para el vÃ­nculo inicial
  sex       Sex? // obligatorio si juega
  nickname  String?       @db.VarChar(30) // apodo, opcional (máx. 30 caracteres)
  number    Int? // número de camiseta, opcional (0 a 999; CHECK en la migración)
  photo     String?
  birthDate DateTime?     @db.Date // solo se muestra la edad y solo si showAge
  // Qué datos son públicos en el banner del jugador
  showNickname Boolean   @default(true)
  showNumber   Boolean   @default(true)
  showAge      Boolean   @default(false)
  showPhoto    Boolean   @default(false)
  isPlayer  Boolean       @default(false)
  isReferee Boolean       @default(false)
  active    Boolean       @default(true)
  status    ProfileStatus @default(PENDIENTE_VINCULACION)
  createdAt DateTime      @default(now())

  user        User?
  teams       PlayerTeam[]
  assignments MatchAssignment[]
  sanctions   MatchSanction[]
  suspensions PlayerSuspension[]
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Equipos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Team {
  id   String  @id @default(uuid())
  name String
  logo String?
  news News[]

  nickname    String? @db.VarChar(40) // apodo del equipo (banner público)
  city        String? @db.VarChar(60)
  foundedYear Int?

  branches           TeamBranch[]
  modalities         TeamModality[]
  players            PlayerTeam[]
  matchesA           Match[]             @relation("MatchTeamA")
  matchesB           Match[]             @relation("MatchTeamB")
  wonSets            MatchSet[]          @relation("SetWinner")
  assignments        MatchAssignment[]
  playerRequestTeams PlayerRequestTeam[]
  championOf         Tournament[]        @relation("TournamentChampion")
  tournamentTeams    TournamentTeam[]
  stageTeams         StageTeam[]
  standings          StageStanding[]
}

model TeamBranch {
  teamId String
  branch Branch
  logo   String? // escudo propio de esta rama (si no tiene, se usa Team.logo)

  team Team @relation(fields: [teamId], references: [id])

  @@id([teamId, branch])
}

// Modalidades que juega un equipo (foam, cloth o ambas)
model TeamModality {
  teamId   String
  modality Modality

  team Team @relation(fields: [teamId], references: [id])

  @@id([teamId, modality])
}

// Un solo registro con "to" = null por (profileId, branch).
// Se refuerza con Ã­ndice Ãºnico parcial en SQL (ver migraciÃ³n):
// CREATE UNIQUE INDEX "PlayerTeam_active_unique"
//   ON "PlayerTeam"("profileId", "branch") WHERE "to" IS NULL;
model PlayerTeam {
  id        String    @id @default(uuid())
  profileId String
  teamId    String
  branch    Branch
  from      DateTime  @default(now())
  to        DateTime? // null = equipo actual
  isCoach   Boolean   @default(false) // DT: marca visual, sin permisos extra

  profile Profile @relation(fields: [profileId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id])

  @@index([profileId])
  @@index([teamId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Torneos y partidos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Tournament {
  id         String           @id @default(uuid())
  name       String
  startsAt   DateTime?
  endsAt     DateTime?
  branch     Branch
  modality   Modality
  year       Int
  edition    String?
  format     TournamentFormat @default(LEAGUE)
  status     TournamentStatus @default(DRAFT)
  pointsWin  Int              @default(3)
  pointsDraw Int              @default(1)
  pointsLoss Int              @default(0)
  championId String?
  pausedAt   DateTime? // pausado: oculto para todos menos la organización; null = visible
  deletedAt  DateTime? // en "Eliminados": no lo ve nadie (ni la organización) hasta restaurarlo o borrarlo definitivamente

  champion    Team?            @relation("TournamentChampion", fields: [championId], references: [id])
  matches     Match[]
  teams       TournamentTeam[]
  stages      Stage[]
  tiebreakers Tiebreaker[]

  @@index([year])
  @@index([status])
}

model Match {
  id           String      @id @default(uuid())
  tournamentId String? // null = partido suelto (amistoso)
  court        Int?
  branch       Branch
  modality     Modality
  status       MatchStatus @default(SCHEDULED)
  scheduledAt  DateTime? // informativa
  timeSet      Boolean   @default(false) // false = solo se conoce el día; el horario se carga después (no se muestra)
  teamAId      String?
  teamBId      String?
  readyAt      DateTime?
  readyBy      String?
  finishedAt   DateTime?
  hiddenAt     DateTime? // oculto (reversible); null = visible
  hiddenByPause Boolean @default(false) // oculto por pausar el torneo: se restaura al reanudarlo
  statusReason        String? // motivo visible de la suspension o cancelacion
  originalScheduledAt DateTime? // fecha original si el partido se suspendio
  createdAt    DateTime    @default(now())

  tournament   Tournament?       @relation(fields: [tournamentId], references: [id])
  teamA        Team?             @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB        Team?             @relation("MatchTeamB", fields: [teamBId], references: [id])
  assignments  MatchAssignment[]
  sets         MatchSet[]
  clockActions ClockAction[]
  clock        MatchClock?
  sanctions    MatchSanction[]

  stageId    String?
  matchdayId String?
  round      Int?
  slot       Int?
  stage      Stage?    @relation(fields: [stageId], references: [id])
  matchday   Matchday? @relation(fields: [matchdayId], references: [id])

  // Llaves: a que partido pasa el ganador / el perdedor
  venueId    String?
  venue      Venue?    @relation(fields: [venueId], references: [id])

  nextMatchId  String?
  nextSide     MatchSide?
  loserMatchId String?
  loserSide    MatchSide?

  // Llaves: de que lugar de una zona sale cada equipo ({ stageId, position })
  teamAFrom    Json?
  teamBFrom    Json?

  @@index([tournamentId])
  @@index([stageId])
  @@index([matchdayId])
  @@index([venueId])
  @@index([status])
  @@index([scheduledAt])
  @@index([teamAId])
  @@index([teamBId])
}

// REFEREE -> profileId (puede no estar vinculado aÃºn)
// TABLE   -> userId (cuenta)
// Validar en la app (o CHECK en SQL) que se complete el campo segÃºn "function"
model MatchAssignment {
  id        String        @id @default(uuid())
  matchId   String
  function  MatchFunction
  profileId String?
  userId    String?
  teamId    String?

  match   Match    @relation(fields: [matchId], references: [id])
  profile Profile? @relation(fields: [profileId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  team    Team?    @relation(fields: [teamId], references: [id])

  @@unique([matchId, profileId])
  @@unique([matchId, userId])
  @@unique([matchId, teamId])
  @@index([userId])
  @@index([profileId])
  @@index([teamId])
}

// Provisorio: estructura exacta del resultado a definir con Rodri
model MatchSet {
  id           String  @id @default(uuid())
  matchId      String
  number       Int
  winnerTeamId String?
  // Cuándo se decidió el set (queda registrado para siempre): tiempo (1 o 2) y segundos jugados de ese tiempo
  half         Int?
  matchSecond  Int?
  createdAt    DateTime @default(now())

  match      Match @relation(fields: [matchId], references: [id])
  winnerTeam Team? @relation("SetWinner", fields: [winnerTeamId], references: [id])

  @@unique([matchId, number])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ AuditorÃ­a â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ClockAction {
  id      String   @id @default(uuid())
  matchId String
  userId  String
  action  String // START | PAUSE | RESUME | ADJUST ...
  detail  String? // JSON con target/timer/seconds/scope, para el registro legible
  at      DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([matchId])
}

// Estado del reloj de un partido Habilitado/En vivo: se guarda para recuperarlo si el servidor se reinicia.
// Los tiempos son segundos restantes al momento de savedAt. Al recuperarse siempre queda en pausa.
model MatchClock {
  matchId            String   @id
  matchTimeLeft      Int
  setTimeLeft        Int
  timeoutTimeLeft    Int
  isMatchPaused      Boolean
  isSetPaused        Boolean
  isTimeoutRunning   Boolean
  matchHalf          Int      @default(1)
  clothAutoResetUsed Boolean  @default(false)
  timeoutTeam        String? // "A" | "B" mientras hay un tiempo muerto en curso
  timeoutHalf        Int?
  timeoutsUsed       Json // { A: { 1, 2 }, B: { 1, 2 } }
  resumeAfterTimeout Json // { match, set }
  savedAt            DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchResultLog {
  id          String   @id @default(uuid())
  matchId     String // sin relación: sobrevive a la eliminación definitiva del partido
  matchLabel  String // ej. "Equipo A vs Equipo B (cancha 1)", fijado al momento del hecho
  editedBy    String // userId, sin relación (ver editorLabel)
  editorLabel String // apodo, nombre o mail de quien lo hizo, fijado al momento del hecho
  type        String // SET_ADD | SET_EDIT | SET_DELETE | MATCH_EDIT | MATCH_CANCEL | MATCH_HIDE | MATCH_RESTORE | MATCH_PURGE
  description String // frase lista para mostrar
  editedAt    DateTime @default(now())

  @@index([matchId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Favoritos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Favorite {
  userId     String
  targetType String // TEAM | PLAYER | TOURNAMENT
  targetId   String

  user User @relation(fields: [userId], references: [id])

  @@id([userId, targetType, targetId])
}

enum PlayerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlayerRequest {
  id           String              @id @default(cuid())
  userId       String
  name         String
  dni          String
  sex          Sex
  number       Int?
  status       PlayerRequestStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams        PlayerRequestTeam[]

  @@index([status])
  @@index([userId])
}

model PlayerRequestTeam {
  id        String        @id @default(cuid())
  requestId String
  teamId    String
  branch    Branch
  request   PlayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([requestId, branch])
}

// Movimientos de usuarios y administradores (quien hizo que y cuando)
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorEmail String?
  method     String
  path       String
  label      String
  targetId   String?
  status     Int
  data       Json?

  @@index([createdAt])
  @@index([actorId])
}

// ─────────────── Torneos: formatos, zonas y fixture ───────────────

enum TournamentFormat {
  LEAGUE
  LEAGUE_CUP
  CUP
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum StageType {
  LEAGUE
  KNOCKOUT
}

enum TiebreakerCriterion {
  HEAD_TO_HEAD
  SET_DIFFERENCE
  SETS_WON
  WINS
  DRAW_LOT
}

model TournamentTeam {
  tournamentId String
  teamId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  team         Team       @relation(fields: [teamId], references: [id])

  @@id([tournamentId, teamId])
  @@index([teamId])
}

// Una zona o una llave (Zona A y Zona B son dos Stage con la misma phase)
model Stage {
  id           String    @id @default(uuid())
  tournamentId String
  name         String
  type         StageType
  phase        Int
  tier         Int?
  promotions   Int       @default(0)
  relegations  Int       @default(0)
  isPromotion  Boolean   @default(false) // etapa generada sola para el playoff de ascenso/permanencia
  playoffPositions Int[] @default([]) // posiciones (a elección de la organización) que juegan el playoff de ascenso/permanencia

  tournament Tournament      @relation(fields: [tournamentId], references: [id])
  teams      StageTeam[]
  matchdays  Matchday[]
  matches    Match[]
  standings  StageStanding[]

  @@index([tournamentId])
}

model StageTeam {
  stageId    String
  teamId     String
  seed       Int?
  entryRound Int?
  stage      Stage  @relation(fields: [stageId], references: [id])
  team       Team   @relation(fields: [teamId], references: [id])

  @@id([stageId, teamId])
  @@index([teamId])
}

// "Fecha N" de una zona con su día de juego; cada partido puede pisarla con su scheduledAt
model Matchday {
  id      String    @id @default(uuid())
  stageId String
  number  Int
  date    DateTime?
  stage   Stage     @relation(fields: [stageId], references: [id])
  matches Match[]

  @@unique([stageId, number])
}

model Tiebreaker {
  id           String              @id @default(uuid())
  tournamentId String
  order        Int
  criterion    TiebreakerCriterion
  tournament   Tournament          @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, order])
}

// Tabla final congelada al cerrar el torneo (registro histórico permanente)
model StageStanding {
  stageId     String
  teamId      String
  position    Int
  points      Int
  played      Int
  won         Int
  drawn       Int
  lost        Int
  setsFor     Int
  setsAgainst Int
  stage       Stage   @relation(fields: [stageId], references: [id])
  team        Team    @relation(fields: [teamId], references: [id])
  tied        Boolean @default(false)
  zone        String? // PROMOTION | RELEGATION | null

  @@id([stageId, teamId])
  @@index([teamId])
}

enum MatchSide {
  A
  B
}


// Sedes (polideportivos) donde se juegan los partidos; las carga la organización
model Venue {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(80)
  address   String    @db.VarChar(160)
  latitude  Float?
  longitude Float?
  mapUrl    String?   @db.VarChar(300) // enlace pegado desde Google/Apple Maps (opcional)
  courts    Int? // canchas disponibles habitualmente (sugerencia al armar la jornada)
  notes     String?   @db.VarChar(300)
  deletedAt DateTime? // baja lógica: los partidos que la usaron la conservan
  createdAt DateTime  @default(now())

  matches Match[]

  @@index([deletedAt])
}


enum SanctionKind {
  WARNING // advertencia (solo Foam): la 2.ª del mismo jugador lo elimina
  YELLOW // 5 minutos afuera (Foam y Cloth)
  BLUE // solo Cloth: 3 minutos o 2 sets afuera, lo que ocurra primero
  RED // expulsión del jugador: queda para el departamento de sanciones
}

// Sanciones de un partido (quedan registradas para siempre; deshacer = revokedAt)
model MatchSanction {
  id          String       @id @default(uuid())
  matchId     String
  side        MatchSide // equipo sancionado
  profileId   String? // jugador (opcional: se puede sancionar sin identificarlo)
  kind        SanctionKind
  eliminates  Boolean      @default(false) // advertencia que eliminó al jugador (2.ª en Foam)
  reason      String?      @db.VarChar(200)
  half        Int? // tiempo (1 o 2)
  setNumber   Int? // set en juego al sancionar
  matchSecond Int? // segundos jugados de ese tiempo
  createdById String?
  createdAt   DateTime     @default(now())
  endedAt     DateTime? // la amarilla o azul terminó sola
  revokedAt   DateTime? // la mesa la deshizo

  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  suspension PlayerSuspension?

  @@index([matchId])
  @@index([profileId])
}

// Decision del departamento de sanciones sobre una roja (fechas=0 y sameDay=false: evaluada sin suspension)
model PlayerSuspension {
  id          String   @id @default(uuid())
  sanctionId  String   @unique
  profileId   String
  fechas      Int      @default(0) // fechas completas posteriores a la roja
  sameDay     Boolean  @default(false) // tambien queda afuera lo que resta de la misma jornada
  scope       String   @default("MODALITY") // MODALITY = solo la modalidad de la roja | ALL = todas las modalidades y equipos
  note        String?  @db.VarChar(300)
  decidedById String?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  sanction MatchSanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  profile  Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}


// Noticias de la liga: las publica la organización (después se define quién más puede redactar)
model News {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(140)
  summary     String?   @db.VarChar(280) // bajada corta que se ve en el listado
  body        String    @db.Text
  imageUrl    String?   @db.VarChar(500) // portada opcional
  teamId      String? // si es de un equipo, aparece en "Mi equipo"
  authorId    String
  authorName  String    @db.VarChar(80) // se guarda el nombre para mostrarlo aunque la cuenta cambie
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // baja lógica

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([teamId])
}


// Planilla de juego fotografiada por la mesa. Queda guardada siempre (auditoría): no se borra ni se pisa.
model MatchSheet {
  id            String    @id @default(uuid())
  matchId       String
  kind          String    @default("PRE") @db.VarChar(8) // PRE = antes del partido
  imagePath     String // en el bucket privado match-sheets
  sha256        String    @db.VarChar(64) // huella de la foto original
  mime          String    @db.VarChar(30)
  bytes         Int
  uploadedById  String
  uploadedAt    DateTime  @default(now())
  provider      String?   @db.VarChar(20) // quién la leyó (gemini)
  aiModel       String?   @db.VarChar(60)
  extracted     Json? // lo que leyó la herramienta, sin tocar
  aiError       String?   @db.VarChar(300)
  confirmed     Json? // lo que confirmó la mesa
  status        String    @default("PENDING") @db.VarChar(12) // PENDING | CONFIRMED | SUPERSEDED
  confirmedById String?
  confirmedAt   DateTime?

  @@index([matchId, uploadedAt])
}

// Quién juega el partido según la planilla confirmada (los demás se ven en gris)
model MatchAttendance {
  id        String  @id @default(uuid())
  matchId   String
  profileId String
  teamId    String
  present   Boolean
  sheetId   String

  @@unique([matchId, profileId])
  @@index([matchId])
}
